        <!-- Tambah baris sesuai jumlah responden -->
      </tbody>
    </table>
  </section>

  <section id="nodes">
    <h2>Node Classification — Tema & Subtema</h2>
    <p class="small">Daftar node yang direkomendasikan untuk dibuat di NVivo (Nodes → New Node / Import Codebook bila tersedia).</p>

    <table aria-label="Node Classification">
