        <tr><td>N01</td><td>Peluang</td><td>Kreativitas konten</td><td>Penggunaan deepfake meningkatkan daya tarik promosi</td><td>Tujuan 1</td></tr>
        <tr><td>N02</td><td>Peluang</td><td>Efisiensi biaya</td><td>Mengurangi biaya pembuatan iklan konvensional</td><td>Tujuan 1</td></tr>
        <tr><td>N03</td><td>Tantangan</td><td>Etika & privasi</td><td>Potensi pelanggaran identitas atau manipulasi opini</td><td>Tujuan 1</td></tr>
        <tr><td>N04</td><td>Dampak Ekonomi</td><td>Peningkatan penjualan</td><td>Kenaikan penjualan setelah konten deepfake</td><td>Tujuan 2</td></tr>
